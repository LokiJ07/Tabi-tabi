extends SceneTree

const NightModel = preload("res://scripts/narrative/night01_state.gd")
var failures := 0


func _initialize() -> void:
	call_deferred("run_tests")


func check(value: bool, name: String) -> void:
	if not value:
		failures += 1
		printerr("FAILED: " + name)


func run_tests() -> void:
	var m = NightModel.new()
	check(not m.can_begin(), "cannot start without clues")
	check(m.observe_clue("light_retreat"), "first clue")
	check(not m.observe_clue("light_retreat"), "duplicate clue ignored")
	check(m.observe_clue("old_mooring"), "second clue")
	check(m.observe_clue("boatman_name"), "third clue")
	check(m.has_complete_evidence(), "three kinds of evidence")
	check(not m.can_begin(), "unlinked clues cannot start encounter")
	check(not m.link_evidence("invalid"), "unknown link rejected")
	check(m.link_evidence("light_mooring"), "link light with location")
	check(not m.link_evidence("light_mooring"), "duplicate link ignored")
	check(not m.can_begin(), "both links necessary")
	check(m.link_evidence("ledger_mooring"), "link ledger to mooring")
	check(m.can_begin(), "both linked evidence pairs allow encounter")
	m.choose_hypothesis("attack")
	m.choose_hypothesis("guide")
	check(m.revision_count == 1, "revising hypothesis allowed")
	check(m.begin(), "begin encounter")
	check(not m.begin(), "cannot start twice")
	m.alarm = 0.8
	check(not m.advance_observation(), "high alarm blocks approach")
	check(m.shade_lantern(), "cloth can calm the first encounter")
	check(not m.shade_lantern(), "cloth is not infinite")
	m.alarm = 0.2
	check(m.advance_observation(), "calm observation advances")
	check(not m.choose_reflection("false_mirror"), "false reflection deterministic")
	check(m.choose_reflection("current_aligned"), "correct reflection")
	check(m.commit_result("resolve"), "resolve commit")
	check(not m.commit_result("drive_away"), "outcome cannot be overwritten")
	check(m.committed_events.size() == 1, "single canonical outcome")
	check(not m.retry_from_checkpoint(), "cannot retry committed outcome")
	var snapshot = NightModel.new()
	for clue in NightModel.REQUIRED:
		snapshot.observe_clue(clue)
	check(not snapshot.begin(), "evidence-only checkpoint cannot start")
	check(snapshot.link_evidence("light_mooring"), "snapshot link one")
	check(snapshot.link_evidence("ledger_mooring"), "snapshot link two")
	check(snapshot.begin(), "start before save")
	check(snapshot.advance_observation(), "phase two checkpoint")
	var checkpoint_copy = NightModel.new()
	check(checkpoint_copy.from_dict(snapshot.to_dict()), "load with checkpoint")
	check(checkpoint_copy.retry_from_checkpoint(), "checkpoint survives save/load")
	check(checkpoint_copy.phase == 2, "restarted at phase two")
	var restored = NightModel.new()
	check(restored.from_dict(m.to_dict()), "restore save")
	check(restored.outcome == "resolve", "saved outcome persists")
	check(restored.has_linked_evidence(), "linked clues survive save and load")
	check(restored.kit.is_used("cloth_wrap"), "used supplies persist")
	check(restored.committed_events.size() == 1, "no duplicate events")
	check(not restored.commit_result("partial"), "cannot duplicate outcome after load")
	var second = NightModel.new()
	for clue in NightModel.REQUIRED:
		second.observe_clue(clue)
	second.link_evidence("light_mooring")
	second.link_evidence("ledger_mooring")
	second.begin()
	check(second.accept_partial(), "partial is safe exit")
	check(second.outcome == "partial", "partial committed")
	var third = NightModel.new()
	for clue in NightModel.REQUIRED:
		third.observe_clue(clue)
	third.link_evidence("light_mooring")
	third.link_evidence("ledger_mooring")
	third.begin()
	third.advance_observation()
	third.choose_reflection("current_aligned")
	check(third.commit_result("drive_away"), "drive away available")
	check(not third.from_dict({"schema": 42}), "reject incompatible schema")
	var alternative = NightModel.new()
	for clue in NightModel.REQUIRED:
		alternative.observe_clue(clue)
	alternative.link_evidence("light_mooring")
	alternative.link_evidence("ledger_mooring")
	check(alternative.kit.toggle("signal_bell"), "can remove warning bell before night")
	check(not alternative.can_begin(), "cannot begin with 3 of 4 supplies")
	check(alternative.kit.toggle("dog_treat"), "substitute equipment restores four")
	check(alternative.can_begin(), "alternate loadout may begin")
	alternative.begin()
	alternative.advance_observation()
	alternative.choose_reflection("current_aligned")
	check(not alternative.commit_result("drive_away"), "bell needed to choose drive away")
	check(alternative.commit_result("resolve"), "alternate loadout still allows nonviolent resolve")
	var old_save: Dictionary = snapshot.to_dict()
	old_save.erase("kit")
	var legacy = NightModel.new()
	check(legacy.from_dict(old_save), "older save without kit supported")
	check(legacy.kit.is_ready(), "safe default kit on migration")
	print("Night 1 model tests: ", "PASS" if failures == 0 else str(failures) + " failures")
	quit(0 if failures == 0 else 1)
